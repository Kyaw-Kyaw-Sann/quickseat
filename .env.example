# QuickSeat local environment template.
# Copy this file to .env, then replace required placeholder values.
# Do not commit your .env file.

# Required: PostgreSQL / Neon JDBC connection
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=

# Profile and local frontend
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
VERIFICATION_BASE_URL=http://localhost:8080/api/v1/auth/verify-email
TICKET_VALIDATION_BASE_URL=http://localhost:8080/api/v1/staff/tickets/validate

# Seat hold behavior
SEAT_HOLD_DURATION_MINUTES=5
SEAT_HOLD_CLEANUP_INTERVAL_MS=60000

# Email: keep disabled unless valid Gmail SMTP credentials are supplied
MAIL_ENABLED=false
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Cloudinary: keep disabled unless upload credentials are supplied
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth: keep disabled unless OAuth credentials are supplied
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development-only demo data. Never enable this for shared/production data.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=DemoPassword123!

# Production only: Swagger is disabled unless explicitly enabled.
SWAGGER_ENABLED=false
